# aidc-managed
# Thin per-project layer (issue #7). Everything project-independent — OS,
# uv/Python, scanners, pmg, coding agents — lives in the shared base image
# (Dockerfile.base), built once and reused. This layer adds only the per-project
# delta: detected toolchains, opt-in security tools, and the project-setup hook.
# AIDC_BASE_IMAGE is the content-hashed base tag from aidc::ensure_base_image
# (compose passes it as a build arg); the aidc-base:latest default is a fallback.
ARG AIDC_BASE_IMAGE=aidc-base:latest
FROM ${AIDC_BASE_IMAGE}
# Re-declared after FROM so it's usable below; the label records which base this
# thin image was built on. aidc compares it against the current base tag and
# forces a rebuild when they differ (e.g. the AIDC_AGENTS selection or the base
# template changed) instead of fast-starting a now-stale image.
ARG AIDC_BASE_IMAGE
LABEL aidc.base="${AIDC_BASE_IMAGE}"

# Shared read-only toolchain volume (issue #9): Go/Rust/JDK live in the
# aidc_toolchains volume (populated by 'aidc tools install', mounted read-only
# at /opt/toolchains by compose — see Dockerfile.toolchain). Their bin dirs are
# on PATH ahead of /usr/local/bin; the dirs are empty (harmless) until the
# matching toolchain is installed. The volume is not present at build time, so
# the go/rust/java arms below only record where the toolchain comes from.
ENV PATH=/home/vscode/.pmg/bin:/home/vscode/.local/bin:/opt/toolchains/go/bin:/opt/toolchains/rust/bin:/opt/toolchains/java/bin:/usr/local/bin:/usr/bin:/bin
ENV GOROOT=/opt/toolchains/go \
    RUSTUP_HOME=/opt/toolchains/rust/rustup \
    JAVA_HOME=/opt/toolchains/java

# Auto-detected toolchains. aidc fills AIDC_TOOLCHAINS by scanning the
# workspace for marker files (go.mod, Cargo.toml, etc.). Override per repo
# by setting AIDC_TOOLCHAINS in .ai-container/project.env. Go/Rust/Java come
# from the shared volume (gosec/cargo-audit ship inside it); the rest install
# into this per-project layer.
ARG AIDC_TOOLCHAINS=""
RUN if [ -n "$AIDC_TOOLCHAINS" ]; then \
      echo "aidc: installing toolchains: $AIDC_TOOLCHAINS"; \
      for tc in $(echo "$AIDC_TOOLCHAINS" | tr ',' ' '); do \
        case "$tc" in \
          go) \
            echo "aidc: go toolchain + gosec provided by the shared volume (/opt/toolchains/go); run 'aidc tools install go' if missing" ;; \
          rust) \
            echo "aidc: rust toolchain + cargo-audit provided by the shared volume (/opt/toolchains/rust); run 'aidc tools install rust' if missing" ;; \
          java) \
            echo "aidc: java toolchain provided by the shared volume (/opt/toolchains/java); run 'aidc tools install java' if missing" ;; \
          ruby) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends ruby-full && \
            sudo gem install --no-document bundler-audit && \
            sudo rm -rf /var/lib/gems/*/cache ;; \
          php) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends php-cli ;; \
          shell) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends shellcheck ;; \
          node) \
            sudo mkdir -p /etc/apt/keyrings && \
            curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
            echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | sudo tee /etc/apt/sources.list.d/nodesource.list >/dev/null && \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends nodejs ;; \
          python) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install bandit && \
            uv cache clean && \
            echo "aidc: python 3.13 already in base (uv-managed); bandit installed" ;; \
          *) \
            echo "aidc: unknown toolchain '$tc' (skipped)" >&2 ;; \
        esac; \
      done; \
      sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*; \
    fi

# Opt-in per-project security tools. aidc reads AIDC_SECURITY_TOOLS from
# .ai-container/project.env (comma-separated). Tools install under
# /home/vscode/.local so no sudo needed.
ARG AIDC_SECURITY_TOOLS=""
RUN if [ -n "$AIDC_SECURITY_TOOLS" ]; then \
      echo "aidc: installing security tools: $AIDC_SECURITY_TOOLS"; \
      mkdir -p "$HOME/.local/bin" "$HOME/.local/share/uv-tools"; \
      for tool in $(echo "$AIDC_SECURITY_TOOLS" | tr ',' ' '); do \
        case "$tool" in \
          grype) \
            echo "aidc: grype is always-on in the base image; skipping" ;; \
          syft) \
            echo "aidc: syft is always-on in the base image; skipping" ;; \
          checkov) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install checkov && \
            uv cache clean ;; \
          bandit) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install bandit && \
            uv cache clean ;; \
          *) \
            echo "aidc: unknown security tool '$tool' (skipped)" >&2 ;; \
        esac; \
      done; \
    fi

# Per-project setup hook. User-owned, copied verbatim from the workspace.
# Last in the Dockerfile so edits invalidate only this layer.
COPY --chown=vscode:vscode project-setup.sh /tmp/aidc-project-setup.sh
RUN bash /tmp/aidc-project-setup.sh && rm /tmp/aidc-project-setup.sh

WORKDIR /workspace
