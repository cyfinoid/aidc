# aidc-managed
# Per-project layer. The common tooling (base OS, apt tools, uv/Python,
# coding agents, always-on scanners, pmg wiring) lives in the shared
# aidc-base image — built once by aidc::ensure_base_image and reused by
# every project via AIDC_BASE_IMAGE. This Dockerfile only adds the
# per-project toolchains, opt-in security tools, and the project setup hook,
# so a fresh project build is minutes instead of tens of minutes and N
# projects share ~3GB of identical layers on disk.
#
# AIDC_BASE_IMAGE is set by lib/aidc.sh (content-hashed aidc-base tag) and
# passed through compose build args. Override per repo with
# AIDC_BASE_IMAGE=<tag> in .ai-container/project.env.
ARG AIDC_BASE_IMAGE=aidc-base:latest
FROM ${AIDC_BASE_IMAGE}

# Auto-detected toolchains. aidc fills AIDC_TOOLCHAINS by scanning the
# workspace for marker files (go.mod, Cargo.toml, etc.). Override per repo
# by setting AIDC_TOOLCHAINS in .ai-container/project.env.
ARG AIDC_TOOLCHAINS=""
RUN if [ -n "$AIDC_TOOLCHAINS" ]; then \
      echo "aidc: installing toolchains: $AIDC_TOOLCHAINS"; \
      for tc in $(echo "$AIDC_TOOLCHAINS" | tr ',' ' '); do \
        case "$tc" in \
          go) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends golang-go && \
            GOBIN=/home/vscode/.local/bin go install github.com/securego/gosec/v2/cmd/gosec@latest ;; \
          rust) \
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
              | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path && \
            mkdir -p /home/vscode/.local/bin && \
            ln -sf "$HOME/.cargo/bin/cargo" /home/vscode/.local/bin/cargo && \
            ln -sf "$HOME/.cargo/bin/rustc" /home/vscode/.local/bin/rustc && \
            ln -sf "$HOME/.cargo/bin/rustup" /home/vscode/.local/bin/rustup && \
            "$HOME/.cargo/bin/cargo" install cargo-audit --locked && \
            ln -sf "$HOME/.cargo/bin/cargo-audit" /home/vscode/.local/bin/cargo-audit ;; \
          ruby) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends ruby-full && \
            sudo gem install --no-document bundler-audit ;; \
          java) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends default-jdk ;; \
          php) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends php-cli ;; \
          shell) \
            sudo apt-get update && \
            sudo apt-get install -y --no-install-recommends shellcheck ;; \
          node) \
            echo "aidc: node 22 already in base (npm/pnpm/yarn/bun via pmg shims; npm audit built-in)" ;; \
          python) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install bandit && \
            echo "aidc: python 3.13 already in base (uv-managed); bandit installed" ;; \
          *) \
            echo "aidc: unknown toolchain '$tc' (skipped)" >&2 ;; \
        esac; \
      done; \
      sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*; \
    fi

# Opt-in per-project security tools. aidc reads AIDC_SECURITY_TOOLS from
# .ai-container/project.env (comma-separated). Tools install under
# /home/vscode/.local so no sudo needed.
ARG AIDC_SECURITY_TOOLS=""
RUN if [ -n "$AIDC_SECURITY_TOOLS" ]; then \
      echo "aidc: installing security tools: $AIDC_SECURITY_TOOLS"; \
      mkdir -p "$HOME/.local/bin" "$HOME/.local/share/uv-tools"; \
      for tool in $(echo "$AIDC_SECURITY_TOOLS" | tr ',' ' '); do \
        case "$tool" in \
          grype) \
            curl -fsSL https://raw.githubusercontent.com/anchore/grype/main/install.sh \
              | sh -s -- -b "$HOME/.local/bin" ;; \
          syft) \
            curl -fsSL https://raw.githubusercontent.com/anchore/syft/main/install.sh \
              | sh -s -- -b "$HOME/.local/bin" ;; \
          checkov) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install checkov ;; \
          bandit) \
            UV_TOOL_BIN_DIR="$HOME/.local/bin" \
            UV_TOOL_DIR="$HOME/.local/share/uv-tools" \
            uv tool install bandit ;; \
          *) \
            echo "aidc: unknown security tool '$tool' (skipped)" >&2 ;; \
        esac; \
      done; \
    fi

# Per-project setup hook. User-owned, copied verbatim from the workspace.
# Last in the Dockerfile so edits invalidate only this layer.
COPY --chown=vscode:vscode project-setup.sh /tmp/aidc-project-setup.sh
RUN bash /tmp/aidc-project-setup.sh && rm /tmp/aidc-project-setup.sh

WORKDIR /workspace
