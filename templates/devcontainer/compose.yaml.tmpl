# aidc-managed
services:
  workspace:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        AIDC_BASE_IMAGE: ${AIDC_BASE_IMAGE:-aidc-base:latest}
        AIDC_TOOLCHAINS: ${AIDC_TOOLCHAINS:-}
        AIDC_SECURITY_TOOLS: ${AIDC_SECURITY_TOOLS:-}
        AIDC_AGENTS: ${AIDC_AGENTS:-}
    init: true
    stdin_open: true
    tty: true
    user: vscode
    working_dir: /workspace
    # No cap_add here: Docker's default capability set is enough for normal
    # development (ping, sudo, chown all work). NET_ADMIN/NET_RAW are granted
    # only when the egress firewall is enabled, via compose.firewall.yaml —
    # aidc adds that file to the compose invocation automatically.
    # Resource knobs (host-wide in ~/.config/aidc/config.env or per project in
    # .ai-container/project.env). Defaults: pids capped (fork-bomb guard,
    # invisible in normal use), memory/CPU unlimited.
    pids_limit: ${AIDC_PIDS_LIMIT:-4096}
    mem_limit: ${AIDC_MEM_LIMIT:-0}
    cpus: ${AIDC_CPU_LIMIT:-0}
    environment:
      HOME: /home/vscode
      HISTFILE: /commandhistory/.zsh_history
      GIT_CONFIG_GLOBAL: /home/vscode/.gitconfig.local
      AIDC_CONTAINER_HOME: /home/vscode
      AIDC_CORE_LOGICS_DIR: /opt/CORE_LOGICS
      AIDC_WORKSPACE_DIR: /workspace
    command:
      - /bin/bash
      - -lc
      - /workspace/.devcontainer/scripts/bootstrap-state.sh init && sleep infinity
    volumes:
      - type: bind
        source: ${AIDC_WORKSPACE}
        target: /workspace
      - type: bind
        source: ${AIDC_DEVCONTAINER_DIR}
        target: /workspace/.devcontainer
        read_only: true
      - type: bind
        source: ${AIDC_CORE_LOGICS_WORKTREE}
        target: /opt/CORE_LOGICS
      - type: bind
        source: ${AIDC_HOST_SEED_CLAUDE}
        target: /host-seed/claude
        read_only: true
      - type: bind
        source: ${AIDC_HOST_SEED_CODEX}
        target: /host-seed/codex
        read_only: true
      - type: bind
        source: ${AIDC_HOST_SEED_OPENCODE}
        target: /host-seed/opencode
        read_only: true
      - type: bind
        source: ${AIDC_HOST_SEED_GROK}
        target: /host-seed/grok
        read_only: true
      - type: bind
        source: ${AIDC_HOST_SEED_OMP}
        target: /host-seed/omp
        read_only: true
      - type: bind
        source: ${AIDC_HOST_SEED_CURSOR}
        target: /host-seed/cursor
        read_only: true
      - type: bind
        source: ${AIDC_GITCONFIG_SOURCE}
        target: /host-seed/gitconfig
        read_only: true
      - type: bind
        source: ${AIDC_CLIPBOARD_DIR_SOURCE}
        target: /host-clipboard
        read_only: true
      - type: volume
        source: command_history
        target: /commandhistory
      - type: volume
        source: claude_home
        target: /home/vscode/.claude
      - type: volume
        source: codex_home
        target: /home/vscode/.codex
      - type: volume
        source: opencode_home
        target: /home/vscode/.config/opencode
      # Cursor CLI (cursor-agent) stores config + login under ~/.cursor
      # (~/.cursor/cli-config.json), NOT ~/.cursor-agent — so the volume mounts
      # there to persist logins across container recreation.
      - type: volume
        source: cursor_agent_home
        target: /home/vscode/.cursor
      - type: volume
        source: grok_home
        target: /home/vscode/.grok
      - type: volume
        source: omp_home
        target: /home/vscode/.omp
      # Shared read-only toolchain store (issue #9): one copy of Go/Rust/JDK
      # (+ gosec/cargo-audit) serves all projects, populated by
      # 'aidc tools install'. Read-only so agents can't tamper with the shared
      # toolchain; revoke by repopulating the volume.
      - type: volume
        source: aidc_toolchains
        target: /opt/toolchains
        read_only: true

volumes:
  command_history:
  # Shared across ALL projects (not project-scoped), so it is external: aidc
  # creates/populates it via 'aidc tools install' and never removes it on a
  # per-project 'aidc destroy'. aidc ensures it exists before compose runs.
  aidc_toolchains:
    external: true
  claude_home:
  codex_home:
  opencode_home:
  cursor_agent_home:
  grok_home:
  omp_home:
