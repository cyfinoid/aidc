#!/usr/bin/env bash
set -euo pipefail

mode="${1:-init}"
tool="${2:-all}"
home_dir="${AIDC_CONTAINER_HOME:-/home/aidc}"

project_env="/workspace/.ai-container/project.env"
if [[ -f "$project_env" ]]; then
  # shellcheck disable=SC1090
  . "$project_env"
fi

ensure_dir() {
  mkdir -p "$1"
}

copy_file_from_seed() {
  local source="$1"
  local target="$2"
  local perms="$3"

  [[ -f "$source" ]] || return 0
  ensure_dir "$(dirname "$target")"

  if [[ "$mode" == "init" && -e "$target" ]]; then
    return 0
  fi

  cp "$source" "$target"
  chmod "$perms" "$target"
}

# Re-seed a credential-bearing file from the host on EVERY bootstrap, not just
# the first. copy_file_from_seed is init-once — in init mode an existing
# volume copy wins forever — which is right for state the container may have
# customized, but wrong for credentials: a host-side `opencode auth login` or
# an apiKey rotated in opencode.json after the first seed never reached new
# sessions, because the stale volume copy shadowed it (they live in persistent
# named volumes that container recreation doesn't touch). The host seed wins
# whenever the host file exists; a missing host file is a no-op, so state that
# exists only inside the container (an in-container-only login) still
# survives. Mode-independent: identical on init and sync.
sync_file_from_seed() {
  local source="$1"
  local target="$2"
  local perms="${3:-0600}"

  [[ -f "$source" ]] || return 0
  ensure_dir "$(dirname "$target")"
  # Warn-and-continue, not die: bootstrap-state.sh is the container start
  # command, and an unwritable volume target (e.g. a root-owned dir
  # materialized by an older image — the failure class ensure_rtk_data_dir
  # repairs below) must degrade to the stale copy rather than kill the
  # session. Same fail-open convention as the python merges in this script.
  # chmod is inside the guarded chain too: fresh content with stale perms is
  # the same unwarned-degrade class.
  if cp "$source" "$target" 2>/dev/null && chmod "$perms" "$target" 2>/dev/null; then
    :
  else
    echo "[bootstrap] could not re-seed $target from $source (unwritable target?) — keeping the existing copy" >&2
  fi
}

copy_dir_from_seed() {
  local source="$1"
  local target="$2"

  [[ -d "$source" ]] || return 0

  if [[ "$mode" == "init" && -d "$target" ]]; then
    return 0
  fi

  ensure_dir "$target"
  rsync -a --delete "$source"/ "$target"/
}

# Remove hook entries that reference host-only tooling from a Claude Code
# settings.json: `gryph` (agent audit layer — handled on the host now that
# sessions auto-sync) and `cot` (whose command is a hard-coded macOS binary
# path that can never resolve inside the VM). Surgical and idempotent: rtk's
# PreToolUse/Bash hook and any user hooks are preserved; only matching commands
# are dropped, then emptied hook arrays and emptied event keys are pruned. The
# file is left untouched when nothing matches. Safe to run on every init, which
# also self-heals settings.json on volumes seeded by an older bootstrap.
strip_host_hooks() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$f" <<'PY'
import json, re, sys
p = sys.argv[1]
try:
    cfg = json.load(open(p))
except (FileNotFoundError, ValueError):
    sys.exit(0)
hooks = cfg.get("hooks")
if not isinstance(hooks, dict):
    sys.exit(0)
bad = re.compile(r"\bgryph\b|\bcot\b")
changed = False
for event in list(hooks):
    entries = hooks[event]
    if not isinstance(entries, list):
        continue
    kept_entries = []
    for entry in entries:
        cmds = entry.get("hooks") if isinstance(entry, dict) else None
        if not isinstance(cmds, list):
            kept_entries.append(entry)
            continue
        kept = [c for c in cmds if not bad.search(c.get("command", ""))]
        if len(kept) != len(cmds):
            changed = True
        if kept:
            entry["hooks"] = kept
            kept_entries.append(entry)
    if kept_entries:
        hooks[event] = kept_entries
    else:
        del hooks[event]
        changed = True
if changed:
    with open(p, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
PY
}

# Wire rtk's SessionEnd reporter into Claude Code's settings.json: a hook that
# prints the rtk token-savings summary when a session ends (via exit 2 + stderr
# — the only display channel Claude Code offers at SessionEnd; see the script's
# header). Added when AIDC_RTK_SESSION_END_HOOK=1 (default) AND the script
# exists in the read-only scaffold overlay; removed when the knob is 0. Other
# hooks are always preserved. Idempotent; safe to run on every init, which also
# self-heals settings.json on volumes seeded by an older bootstrap.
ensure_rtk_session_end_settings() {
  local f="$1"
  local script="${2:-/workspace/.devcontainer/scripts/rtk-session-end.sh}"
  command -v python3 >/dev/null 2>&1 || return 0
  local enforce="${AIDC_RTK_SESSION_END_HOOK:-1}"
  [[ "$enforce" == "1" && ! -f "$script" ]] && enforce=0
  AIDC_RTK_HOOK_ENFORCE="$enforce" AIDC_RTK_HOOK_SCRIPT="$script" python3 - "$f" <<'PY'
import json, os, sys
p = sys.argv[1]
enforce = os.environ.get("AIDC_RTK_HOOK_ENFORCE", "1") == "1"
cmd = os.environ.get("AIDC_RTK_HOOK_SCRIPT", "/workspace/.devcontainer/scripts/rtk-session-end.sh")
try:
    cfg = json.load(open(p))
except (FileNotFoundError, ValueError):
    cfg = {}
changed = False
hooks = cfg.setdefault("hooks", {})
events = hooks.setdefault("SessionEnd", [])
have = any(
    isinstance(e, dict)
    and any(h.get("command") == cmd for h in e.get("hooks", []) if isinstance(h, dict))
    for e in events if isinstance(e, dict)
)
if enforce and not have:
    events.append({"hooks": [{"type": "command", "command": cmd}]})
    changed = True
elif not enforce and have:
    for e in events:
        if isinstance(e, dict) and isinstance(e.get("hooks"), list):
            kept = [h for h in e["hooks"] if not (isinstance(h, dict) and h.get("command") == cmd)]
            if len(kept) != len(e["hooks"]):
                e["hooks"] = kept
                changed = True
    hooks["SessionEnd"] = [e for e in events if not (isinstance(e, dict) and e.get("hooks") == [])]
if not hooks.get("SessionEnd"):
    hooks.pop("SessionEnd", None)
if not cfg.get("hooks"):
    cfg.pop("hooks", None)
if changed:
    with open(p, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
PY
  chmod 0600 "$f" 2>/dev/null || true
}

# Seed the aidc guardrail posture into Claude Code's settings.json:
#   - Stop hooks for the aidc guardrails — aidc-scan-hook.sh (mechanical
#     enforcement of the "scan before done" guardrail, knob
#     AIDC_ENFORCE_SCAN_HOOK) and aidc-review-hook.sh (mechanical
#     enforcement of the "review before done" guardrail, knob
#     AIDC_ENFORCE_REVIEW_HOOK; both default to on). Each hook is added or
#     removed independently of the other; other hooks are always preserved.
#   - enableAllProjectMcpServers pinned to false when absent, so project
#     .mcp.json servers keep requiring explicit approval.
# Idempotent; creates the file if the host seeded none.
ensure_agent_guardrail_settings() {
  local f="$1"
  command -v python3 >/dev/null 2>&1 || return 0
  AIDC_SCAN_HOOK_ENFORCE="${AIDC_ENFORCE_SCAN_HOOK:-1}" \
    AIDC_REVIEW_HOOK_ENFORCE="${AIDC_ENFORCE_REVIEW_HOOK:-1}" \
    python3 - "$f" <<'PY'
import json, os, sys
p = sys.argv[1]
guardrails = [
    ("/workspace/.devcontainer/scripts/aidc-scan-hook.sh",
     os.environ.get("AIDC_SCAN_HOOK_ENFORCE", "1") == "1"),
    ("/workspace/.devcontainer/scripts/aidc-review-hook.sh",
     os.environ.get("AIDC_REVIEW_HOOK_ENFORCE", "1") == "1"),
]
try:
    cfg = json.load(open(p))
except (FileNotFoundError, ValueError):
    cfg = {}
changed = False
hooks = cfg.setdefault("hooks", {})
stops = hooks.setdefault("Stop", [])
for cmd, enforce in guardrails:
    have = any(
        isinstance(e, dict)
        and any(h.get("command") == cmd for h in e.get("hooks", []) if isinstance(h, dict))
        for e in stops if isinstance(e, dict)
    )
    if enforce and not have:
        stops.append({"hooks": [{"type": "command", "command": cmd}]})
        changed = True
    elif not enforce and have:
        for e in stops:
            if isinstance(e, dict) and isinstance(e.get("hooks"), list):
                kept = [h for h in e["hooks"] if not (isinstance(h, dict) and h.get("command") == cmd)]
                if len(kept) != len(e["hooks"]):
                    e["hooks"] = kept
                    changed = True
# Prune entries emptied by a removal, then the event key itself if bare.
hooks["Stop"] = [e for e in stops if isinstance(e, dict) and e.get("hooks")]
if not hooks["Stop"]:
    hooks.pop("Stop", None)
if not cfg.get("hooks"):
    cfg.pop("hooks", None)
if "enableAllProjectMcpServers" not in cfg:
    cfg["enableAllProjectMcpServers"] = False
    changed = True
if changed:
    with open(p, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
PY
  chmod 0600 "$f" 2>/dev/null || true
}

sync_claude() {
  ensure_dir "$home_dir/.claude"
  copy_file_from_seed "/host-seed/claude/settings.json" "$home_dir/.claude/settings.json" "0600"
  copy_file_from_seed "/host-seed/claude/CLAUDE.md" "$home_dir/.claude/CLAUDE.md" "0644"
  # The host's CLAUDE.md imports rtk's usage guidance via `@RTK.md`; without
  # seeding the file the import silently no-ops and the model never sees the
  # rtk command reference (the PreToolUse hook still rewrites mechanically).
  copy_file_from_seed "/host-seed/claude/RTK.md" "$home_dir/.claude/RTK.md" "0644"
  # The host seed's settings.json carries hooks for host-only tools (gryph, cot);
  # they're pointless in the VM and cot would error on every fire. Strip just
  # those — rtk installs its own hook below and any user hooks are preserved.
  strip_host_hooks "$home_dir/.claude/settings.json"
  ensure_agent_guardrail_settings "$home_dir/.claude/settings.json"
  ensure_rtk_session_end_settings "$home_dir/.claude/settings.json"
}

sync_codex() {
  ensure_dir "$home_dir/.codex"
  copy_file_from_seed "/host-seed/codex/auth.json" "$home_dir/.codex/auth.json" "0600"
  copy_file_from_seed "/host-seed/codex/config.toml" "$home_dir/.codex/config.toml" "0600"
  copy_file_from_seed "/host-seed/codex/AGENTS.md" "$home_dir/.codex/AGENTS.md" "0644"
  copy_dir_from_seed "/host-seed/codex/rules" "$home_dir/.codex/rules"
  copy_dir_from_seed "/host-seed/codex/skills" "$home_dir/.codex/skills"
}

sync_opencode() {
  ensure_dir "$home_dir/.config/opencode"
  # opencode.json carries provider credentials (apiKey/baseURL blocks) and
  # auth.json IS the credential store — both re-seed from the host on every
  # start (sync_file_from_seed), so a host-side login or key rotation reaches
  # new sessions without a manual `aidc sync-config opencode`. Anything the
  # host copy drops is re-wired right below (permission allows, rtk + review
  # -gate plugins), so the every-start overwrite is self-healing.
  sync_file_from_seed "/host-seed/opencode/opencode.json" "$home_dir/.config/opencode/opencode.json" "0600"
  copy_dir_from_seed "/host-seed/opencode/plugins" "$home_dir/.config/opencode/plugins"
  # opencode stores provider credentials in the XDG *data* dir, not the config
  # dir: ~/.local/share/opencode/auth.json. Seed it (and it persists via the
  # opencode_data_home volume) so a host `opencode auth login` is inherited —
  # re-applied on every start; a login made only inside the container (no host
  # auth.json) still survives, since a missing host seed is a no-op.
  ensure_dir "$home_dir/.local/share/opencode"
  sync_file_from_seed "/host-seed/opencode-data/auth.json" "$home_dir/.local/share/opencode/auth.json" "0600"
  # Seed the permission allows AFTER the config copy: the host seed overwrite
  # above drops them on every start, so this re-adds them (merge-only — a
  # user-set rule, whatever its value, is never clobbered).
  ensure_opencode_permissions
  # rtk ships an opencode plugin (~/.config/opencode/plugins/rtk.ts). Install
  # AFTER the plugins seeding: copy_dir_from_seed rsync --deletes in sync mode,
  # which would wipe a plugin installed before it. Idempotent, so this repairs
  # the wipe on every init/sync.
  wire_rtk_opencode
  # Same wipe-repair logic for aidc's own review-gate plugin: it must be
  # (re-)copied after the rsync on every init/sync.
  wire_aidc_opencode_gate
}

# Seed opencode's `permission.external_directory` allow rules for the paths
# every aidc session legitimately touches OUTSIDE the workspace — without
# them opencode asks (per session: an "always" approval only lasts the
# current session) on every single one:
#   /opt/CORE_LOGICS/**       the shared guidance repo AGENTS.md tells the
#                             agent to read AND write (aidc mounts it at
#                             /opt/CORE_LOGICS; AIDC_CORE_LOGICS_DIR).
#   ~/.local/share/rtk/**     rtk's history db + tee logs — read/written by
#                             the rtk wiring every command goes through.
#   /tmp/**                   the container's designated scratch space (the
#                             agents' own standing instruction says to use
#                             /tmp/opencode for temporary work).
# Merge-only, never clobber: a key the user (or an explicit host config)
# already set — allow, ask, or deny — is left exactly as it is. Removing the
# knob (AIDC_OPENCODE_SEED_PERMISSIONS=0) deletes only the defaults listed
# above that are still set to "allow", never anything else. Override the
# default list with AIDC_OPENCODE_EXTERNAL_ALLOW (colon-separated glob list;
# empty disables). Idempotent; safe on every init/sync. Same python3-merges
# pattern as ensure_rtk_session_end_settings — fails open without python3.
ensure_opencode_permissions() {
  command -v python3 >/dev/null 2>&1 || return 0
  local cfg="$home_dir/.config/opencode/opencode.json"
  local enforce="${AIDC_OPENCODE_SEED_PERMISSIONS:-1}"
  local defaults="/opt/CORE_LOGICS/**:~/.local/share/rtk/**:/tmp/**"
  # '-' not ':-' so an explicitly-empty override disables seeding entirely.
  local paths="${AIDC_OPENCODE_EXTERNAL_ALLOW-$defaults}"
  AIDC_OC_PERM_ENFORCE="$enforce" AIDC_OC_PERM_PATHS="$paths" \
    AIDC_OC_PERM_DEFAULTS="$defaults" python3 - "$cfg" <<'PY'
import json, os, sys

p = sys.argv[1]
enforce = os.environ.get("AIDC_OC_PERM_ENFORCE", "1") == "1"
defaults = [s for s in os.environ.get("AIDC_OC_PERM_DEFAULTS", "").split(":") if s]
paths = [s for s in os.environ.get("AIDC_OC_PERM_PATHS", "").split(":") if s]

try:
    cfg = json.load(open(p))
except FileNotFoundError:
    cfg = {}
except (ValueError, OSError):
    # Unparseable/unreadable config: leave it exactly as it is (same
    # fail-open contract as strip_host_hooks / ensure_rtk_session_end_settings)
    # — opencode itself will surface the problem to its owner.
    sys.exit(0)
if not isinstance(cfg, dict):
    sys.exit(0)

perm = cfg.get("permission")
if perm is not None and not isinstance(perm, dict):
    # e.g. the documented whole-config shorthand `"permission": "ask"` —
    # a user-set shape we must not replace.
    sys.exit(0)
ext = perm.get("external_directory") if isinstance(perm, dict) else None
if ext is not None and not isinstance(ext, dict):
    # e.g. `"external_directory": "ask"` — likewise a valid user value.
    sys.exit(0)
if not isinstance(ext, dict):
    ext = {}

changed = False
if enforce:
    for path in paths:
        if path not in ext:
            ext[path] = "allow"
            changed = True
else:
    # Off: retract only our defaults, and only where they still say "allow"
    # (a different value means a human put it there).
    for path in defaults:
        if ext.get(path) == "allow":
            del ext[path]
            changed = True

if ext:
    if perm is None:
        perm = {}
    perm["external_directory"] = ext
elif isinstance(perm, dict) and "external_directory" in perm:
    del perm["external_directory"]
if isinstance(perm, dict) and perm:
    cfg["permission"] = perm

# Write only when something changed, or when seeding into a config that does
# not exist yet (never on the retract-only path — nothing to retract, and a
# knob-off invocation must not create files).
if changed or (enforce and paths and not os.path.exists(p)):
    try:
        with open(p, "w") as fh:
            json.dump(cfg, fh, indent=2)
            fh.write("\n")
        # Match the seed contract (copy_file_from_seed 0600): opencode.json can
        # carry provider API keys in custom headers.
        os.chmod(p, 0o600)
    except OSError:
        pass  # fail open: a read-only config dir is not bootstrap's problem
PY
}

sync_grok() {
  ensure_dir "$home_dir/.grok"
  # Grok stores config + credentials under ~/.grok. Filenames differ across
  # builds (config.toml / user-settings.json / an auth file), so copy whichever
  # the host provides — copy_file_from_seed is a no-op when the source is absent.
  copy_file_from_seed "/host-seed/grok/config.toml" "$home_dir/.grok/config.toml" "0600"
  copy_file_from_seed "/host-seed/grok/user-settings.json" "$home_dir/.grok/user-settings.json" "0600"
  copy_file_from_seed "/host-seed/grok/auth.json" "$home_dir/.grok/auth.json" "0600"
}

sync_omp() {
  ensure_dir "$home_dir/.omp/agent"
  # omp (oh-my-pi) keeps its global config and auth store under ~/.omp/agent
  # (config.yml + agent.db). Seed whichever the host provides — copy_file_from_seed
  # is a no-op when the source is absent. Session transcripts live under
  # ~/.omp/agent/sessions and persist via the omp_home volume (not seeded here).
  copy_file_from_seed "/host-seed/omp/agent/config.yml" "$home_dir/.omp/agent/config.yml" "0600"
  copy_file_from_seed "/host-seed/omp/agent/agent.db" "$home_dir/.omp/agent/agent.db" "0600"
  wire_rtk_omp
}

# The rtk_data volume mounts at ~/.local/share/rtk, where rtk keeps history.db —
# the single db every rtk-wired agent appends to and 'rtk gain' reads. The image
# pre-creates that path as aidc so a *fresh* volume inherits the ownership, but
# Docker seeds a named volume only when it is first created: a volume that
# already materialised root-owned (built by an image predating that mkdir) stays
# root-owned through any number of rebuilds, and every rtk invocation then fails
# its db init with EACCES — silently, because rtk still filters fine and the
# SessionEnd reporter is deliberately fail-open. Repair it here; sudo is
# passwordless in the container and this is a no-op once ownership is right.
ensure_rtk_data_dir() {
  local dir="$home_dir/.local/share/rtk"
  [[ -d "$dir" ]] || ensure_dir "$dir" 2>/dev/null || true
  [[ -d "$dir" ]] || return 0
  # -w is the condition that actually matters (uid/gid can differ from 1000 when
  # align_uid has remapped aidc); only escalate when the check fails.
  [[ -w "$dir" ]] && return 0
  sudo -n chown -R "$(id -u):$(id -g)" "$dir" 2>/dev/null || true
  # Re-test rather than trusting chown's exit status: sudo may be absent or
  # non-passwordless, and a chown that reports success still leaves the dir
  # unusable if the mode denies the owner write. Warn, but never fail — this
  # runs from the container entrypoint under `set -e`, where aborting would
  # trade "savings untracked" for "container dead".
  [[ -w "$dir" ]] && return 0
  echo "[bootstrap] $dir not writable and could not be repaired — 'rtk gain' will record nothing" >&2
}

# rtk wiring for the non-claude agents rtk supports (coverage matrix in
# docs/security.md: claude via rtk init in install_agent_hooks, opencode plugin,
# cursor hooks.json, omp via rtk's pi extension; codex/grok unsupported
# upstream). All no-ops without rtk (slim builds) and safe to re-run on every
# init/sync — rtk init --auto-patch is idempotent.
#
# Each helper verifies the artifact actually landed rather than trusting rtk's
# exit code: these run with output discarded, so an unverified failure is
# invisible until someone goes looking for the savings that were never recorded.
wire_rtk_opencode() {
  command -v rtk >/dev/null 2>&1 || return 0
  rtk init --global --auto-patch --hook-only --opencode >/dev/null 2>&1 || true
  [[ -f "$home_dir/.config/opencode/plugins/rtk.ts" ]] \
    || echo "[bootstrap] rtk opencode plugin missing after init" >&2
}

wire_rtk_cursor() {
  command -v rtk >/dev/null 2>&1 || return 0
  # rtk 0.48.0 writes ~/.cursor/hooks.json tmp+rename style but never creates
  # the directory first — pre-create it or init exits 1.
  ensure_dir "$home_dir/.cursor"
  rtk init --global --auto-patch --hook-only --agent cursor >/dev/null 2>&1 || true
  [[ -f "$home_dir/.cursor/hooks.json" ]] \
    || echo "[bootstrap] rtk cursor hooks.json missing after init" >&2
}

# Wire the review gate into Cursor's ~/.cursor/hooks.json as a `stop` hook:
# on clean completions the wrapper runs the shared gate check and, when it
# trips, returns followup_message (Cursor auto-continues the agent with it).
# Merge, never clobber: rtk's preToolUse entry and any user hooks are
# preserved. Idempotent. No removal knob here on purpose — when
# AIDC_ENFORCE_REVIEW_HOOK=0 the gate check exits allow and the entry
# degrades to a cheap no-op; the file still self-heals on every init/sync.
wire_aidc_review_cursor() {
  local wrapper="$scripts_dir/aidc-review-gate-cursor.sh"
  [[ -f "$wrapper" ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  ensure_dir "$home_dir/.cursor"
  AIDC_CURSOR_HOOK_SCRIPT="$wrapper" python3 - "$home_dir/.cursor/hooks.json" <<'PY'
import json, os, sys
p = sys.argv[1]
cmd = os.environ.get("AIDC_CURSOR_HOOK_SCRIPT")
try:
    cfg = json.load(open(p))
except (FileNotFoundError, ValueError):
    cfg = {}
changed = False
cfg.setdefault("version", 1)
hooks = cfg.setdefault("hooks", {})
stops = hooks.setdefault("stop", [])
have = any(
    isinstance(e, dict) and e.get("command") == cmd
    for e in stops
)
if not have:
    stops.append({"command": cmd, "loop_limit": 5})
    changed = True
if changed:
    with open(p, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
PY
  [[ -f "$home_dir/.cursor/hooks.json" ]] \
    || echo "[bootstrap] cursor hooks.json missing after review-gate wiring" >&2
}

# Install aidc's opencode review-gate plugin. Source of truth is the project
# scaffold overlay (upgrades on re-init); the copy lands in the global plugin
# directory. Same wipe-repair contract as wire_rtk_opencode: runs after the
# plugins rsync on every init/sync.
wire_aidc_opencode_gate() {
  local src="$scripts_dir/aidc-review-gate-opencode.ts"
  local dst="$home_dir/.config/opencode/plugins/aidc-review-gate.ts"
  [[ -f "$src" ]] || return 0
  ensure_dir "$(dirname "$dst")"
  cp "$src" "$dst" 2>/dev/null || true
  [[ -f "$dst" ]] \
    || echo "[bootstrap] aidc review-gate opencode plugin missing after install" >&2
}

wire_rtk_omp() {
  command -v rtk >/dev/null 2>&1 || return 0
  # rtk has no omp target. omp is a pi fork that still loads pi extensions when
  # given them explicitly (the launcher passes --extension; loads verified,
  # real-session behavior pending — knob AIDC_RTK_OMP_EXTENSION). Generate the
  # pi extension under a throwaway HOME, with CLAUDE_CONFIG_DIR unset: rtk
  # honors it over HOME and would otherwise write into the real ~/.claude.
  local dst="$home_dir/.omp/agent/extensions/rtk.ts"
  local tmp
  tmp="$(mktemp -d 2>/dev/null)" || return 0
  if env -u CLAUDE_CONFIG_DIR HOME="$tmp" \
       rtk init --global --auto-patch --hook-only --agent pi >/dev/null 2>&1 \
     && [[ -f "$tmp/.pi/agent/extensions/rtk.ts" ]]; then
    ensure_dir "$(dirname "$dst")"
    cp "$tmp/.pi/agent/extensions/rtk.ts" "$dst" 2>/dev/null || true
  fi
  rm -rf "$tmp"
  [[ -f "$dst" ]] || echo "[bootstrap] rtk omp extension missing after init" >&2
}

sync_cursor() {
  ensure_dir "$home_dir/.cursor"
  # Cursor CLI (cursor-agent) reads global *settings* from ~/.cursor/cli-config.json
  # (seeded here). Its interactive-login *token* lives in the macOS Keychain, not a
  # file, so it CANNOT be seeded/inherited into a Linux container. For containers,
  # authenticate with CURSOR_API_KEY (forwarded via AIDC_PASSTHROUGH_ENV_KEYS) —
  # see docs/security.md.
  copy_file_from_seed "/host-seed/cursor/cli-config.json" "$home_dir/.cursor/cli-config.json" "0600"
  wire_rtk_cursor
  # After rtk's merge so both writers coexist (merge is idempotent).
  wire_aidc_review_cursor
}

sync_gitconfig_overlay() {
  local overlay="$home_dir/.gitconfig.local"
  if [[ ! -f "$overlay" && -f /host-seed/gitconfig ]]; then
    cp /host-seed/gitconfig "$overlay"
    chmod 0644 "$overlay"
  fi
}

# Make the aidc container-side tools callable by name (agents run aidc-scan
# and aidc-review-record before declaring work done — see the seeded
# CLAUDE.md/AGENTS.md guardrails; aidc-ci is human/agent convenience for
# replaying the project's workflows).
# The scripts themselves live in the read-only /workspace/.devcontainer
# overlay, so symlinks are all that's needed and they track scaffold
# upgrades automatically.
scripts_dir="${AIDC_CONTAINER_SCRIPTS_DIR:-/workspace/.devcontainer/scripts}"

install_tool_links() {
  local name script
  ensure_dir "$home_dir/.local/bin"
  for name in aidc-scan aidc-review-record aidc-ci; do
    script="$scripts_dir/$name.sh"
    [[ -f "$script" ]] || continue
    ln -sf "$script" "$home_dir/.local/bin/$name"
  done
}

install_agent_hooks() {
  # Marker lives in the claude_home volume so it survives container restarts
  # but is wiped by 'aidc destroy', triggering a fresh re-init.
  local marker="$home_dir/.claude/.aidc-agent-hooks-installed"
  [[ -f "$marker" ]] && return 0

  # rtk is the only agent hook wired inside the VM. gryph/cot run on the host
  # (sessions auto-sync), so neither is installed nor hooked here. --auto-patch
  # makes init non-interactive; --hook-only adds just the PreToolUse/Bash hook
  # without re-writing CLAUDE.md/RTK.md (both already seeded from the host).
  if command -v rtk >/dev/null 2>&1; then
    rtk init --global --auto-patch --hook-only >/dev/null 2>&1 \
      || echo "[bootstrap] rtk init --global failed" >&2
    # Verify the hook landed instead of trusting rtk's exit code (it exits 0 on
    # partial success — the same reason the wire_rtk_* helpers assert), and
    # leave the marker unwritten when it did not. That omission IS the retry
    # channel: the marker lives on the claude_home volume, so writing it after
    # a failed init would pin the container hookless until 'aidc destroy'.
    # Matched on the PreToolUse command rather than the bare string "rtk",
    # which the SessionEnd reporter's own path would also satisfy.
    if ! grep -q '"rtk hook' "$home_dir/.claude/settings.json" 2>/dev/null; then
      echo "[bootstrap] rtk claude hook missing after init — retrying on next start" >&2
      return 0
    fi
  fi

  mkdir -p "$(dirname "$marker")"
  touch "$marker"
}

align_uid() {
  # No-op unless invoked as root AND /workspace is owned by a non-aidc uid.
  # On macOS (Docker Desktop / OrbStack) bind mounts already present the
  # container user's uid, so this stays dormant. Kept here so the setup is
  # correct if the compose entrypoint is ever switched to root.
  [[ "$(id -u)" -eq 0 ]] || return 0
  [[ -d /workspace ]] || return 0

  local host_uid host_gid
  host_uid="$(stat -c %u /workspace 2>/dev/null || echo 1000)"
  host_gid="$(stat -c %g /workspace 2>/dev/null || echo 1000)"
  [[ "$host_uid" -eq 1000 && "$host_gid" -eq 1000 ]] && return 0

  usermod -u "$host_uid" aidc 2>/dev/null || true
  groupmod -g "$host_gid" aidc 2>/dev/null || true
  chown -R "$host_uid:$host_gid" "$home_dir" /commandhistory 2>/dev/null || true
}

run_firewall_if_enabled() {
  [[ "${AIDC_ENABLE_EGRESS_FIREWALL:-0}" == "1" ]] || return 0
  local script="/workspace/.devcontainer/scripts/init-firewall.sh"
  [[ -x "$script" ]] || return 0

  # sudo resets the environment, so the refresh-interval knob is forwarded
  # explicitly (project.env was sourced above).
  local refresh="${AIDC_FIREWALL_REFRESH_SECONDS:-300}"
  if [[ "$(id -u)" -eq 0 ]]; then
    AIDC_FIREWALL_REFRESH_SECONDS="$refresh" "$script" \
      || echo "[bootstrap] firewall init failed" >&2
  else
    sudo -n env AIDC_FIREWALL_REFRESH_SECONDS="$refresh" "$script" \
      || echo "[bootstrap] firewall init failed (sudo required)" >&2
  fi
}

sync_tool() {
  case "$1" in
    claude)
      sync_claude
      ;;
    codex)
      sync_codex
      ;;
    opencode)
      sync_opencode
      ;;
    grok)
      sync_grok
      ;;
    omp)
      sync_omp
      ;;
    cursor)
      sync_cursor
      ;;
    all)
      sync_claude
      sync_codex
      sync_opencode
      sync_grok
      sync_omp
      sync_cursor
      ;;
    *)
      echo "unsupported tool: $1" >&2
      exit 1
      ;;
  esac
}

# Only run the dispatch when executed directly, not when sourced (e.g. by unit
# tests exercising strip_host_hooks()). This keeps the helper functions above
# importable without triggering the init/sync side effects.
if [[ "${BASH_SOURCE[0]:-}" == "${0:-}" ]]; then
  case "$mode" in
    init)
      align_uid
      ensure_dir "/commandhistory"
      # Before anything that shells out to rtk (the wire_rtk_* helpers and
      # install_agent_hooks all do), and after align_uid, which is what can
      # change the uid the ownership has to match.
      ensure_rtk_data_dir
      sync_tool "all"
      sync_gitconfig_overlay
      install_agent_hooks
      install_tool_links
      run_firewall_if_enabled
      ;;
    sync)
      # Also on sync: this is the only repair path for a container whose
      # rtk_data volume already exists root-owned, since rebuilding the image
      # cannot re-seed an existing named volume.
      ensure_rtk_data_dir
      sync_tool "$tool"
      ;;
    *)
      echo "usage: bootstrap-state.sh [init|sync] [claude|codex|opencode|grok|omp|cursor|all]" >&2
      exit 1
      ;;
  esac
fi
